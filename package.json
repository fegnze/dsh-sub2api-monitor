{
  "name": "dsh-sub2api-monitor",
  "version": "0.1.1",
  "license": "MIT",
  "author": "fegnze",
  "icon": "./icon.svg",
  "keywords": ["dsh-plugin", "deepseek-harness", "sub2api", "usage-monitor"],
  "repository": { "type": "git", "url": "git+https://github.com/fegnze/dsh-sub2api-monitor.git" },
  "homepage": "https://github.com/fegnze/dsh-sub2api-monitor#readme",
  "bugs": { "url": "https://github.com/fegnze/dsh-sub2api-monitor/issues" },
  "files": ["src", "locale", "icon.svg", "cordis.patch.yml", "README.md", "LICENSE"],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "dependencies": { "@deepseek-ai/schemastery": "~3.18.4" },
  "peerDependencies": { "@deepseek-ai/cordis": "~4.0.4", "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2" },
  "peerDependenciesMeta": { "@deepseek-ai/dsh-app-boot": { "optional": true }, "@deepseek-ai/cordis": { "optional": true } },
  "type": "module",
  "description": "账号用量：sub2api 额度窗口、重置时间与今日统计",
  "exports": { ".": "./src/host.mjs", "./client": "./src/client.js", "./package.json": "./package.json", "./icon": "./icon.svg", "./locale/*.json": "./locale/*.json" },
  "engines": { "node": ">=22", "dsh": "0.2.0-rc.2" },
  "dsh": { "manifestVersion": 1, "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-slots", "@deepseek-ai/dsh-client-ui-plugin-manager", "@deepseek-ai/dsh-client-ui-conversation"] } },
  "scripts": { "test": "node --test test/*.test.mjs", "probe": "node scripts/probe.mjs" }
}
